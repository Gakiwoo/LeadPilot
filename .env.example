# LeadPilot 云端服务配置样板。复制为 .env 后自行填写；.env 已被 .gitignore 排除。
# 服务启动不会自动加载 .env，请用 shell 导出变量，或由进程管理器注入。

# ── 监听与安全 ────────────────────────────────────────────────
LEADPILOT_HOST=127.0.0.1
LEADPILOT_PORT=5181

# 默认仅允许本机访问且免鉴权。只要 LEADPILOT_HOST 不是 127.0.0.1 / ::1，
# 服务会强制要求设置 LEADPILOT_API_TOKEN，否则拒绝启动（不静默放行）。
LEADPILOT_API_TOKEN=

# CORS 白名单，逗号分隔。默认仅本地前端；不允许在非本机部署时使用 *。
LEADPILOT_CORS=http://127.0.0.1:5180

# 每 IP 每分钟请求上限，超出返回 429 + E6010（带 Retry-After）
# 鉴权失败 401 + E6009；未锁模型快照 E6008；无可用 provider E6005；
# 点数不足 E4001；账本幂等键冲突 E4002；账本状态非法 E4003；标注导入不合规 E4004；
# 网关计费键已结算 E4005；评测 diff 归档非法 E4006；
# 批量导入校验失败 E4007；批量研判输入非法 E4008；草稿导出被合规闸门拒绝 E4009；
# 结果回写非法 / 退信熔断中 E4010。
LEADPILOT_RATE_LIMIT=120

# 持久化：sqlite（Node 22 内置 node:sqlite）/ json（文件兜底）/ memory（重启即丢，仅测试用）
# v0.6.0 起同一存储文件还保存点数账本账户表与流水表（任务 + 网关调用共用一本账），重启不重复扣点。
# v0.7.0 起另存 companies / outcomes 两张表：批量 SDR 导入的线索与发送结果事件。
# 联系人邮箱/姓名只落本地库，发往模型前剥离；服务端不保存发件人身份与合规尾巴文本。
LEADPILOT_STORE=sqlite
LEADPILOT_DB_PATH=./data/leadpilot.db

# ── 批量 SDR 管道（v0.7.0 · 内测）───────────────────────────────
# 定位仍为「自动获客」，目标用户为批量 SDR。CSV 导入是这类用户既有的线索投喂通道，
# origin 恒为 user_imported（导入 ≠ 采集）；官网原文由用户指定 URL 抓取（抓取 ≠ 采集）。
# 单批 CSV/JSON 受 256 KB 请求体与 500 行上限约束，超出请分批。
# POST /v1/import/companies · /v1/batch/judge · /v1/export/eml · /v1/import/outcomes
# 导出 mbox 只建草稿（导出 ≠ 发送），禁止批量直接发送；退信率 > 3% 熔断后续导出。
# 内测可跑 ≠ 可正式发布：OAuth+CASA / EV 签名 / provider 快照 / 法务意见仍是发布门禁。
# v0.8.0 决策后 385 标注与商业数据源采购已取消，不再作为发布前置。

# ── 点数账本（v0.6.0）──────────────────────────────────────────
# 开户初始点数。云端任务 + 网关 judge / write_email 真实调用共用同一本账：
# 有可用 provider 才预扣，内容校验通过才结算，失败/降级/缓存命中全额释放、不扣点。
# 预扣上限按 T0/T1/T2 在 shared/model-protocol.json 的 billing.gatewayBilling.reservePoints 配置。
# 注意：这是本地测试账本，不是真实支付/结算系统；审计里的 points 仍是 token 折算估值，
#       只有响应 billing.charged=true 才代表本次实际扣点。
LEADPILOT_POINTS_BALANCE=2000

# ── 用户指定 URL 抓取（v0.9.0 · ADR-032）────────────────────────
# 只抓调用方显式给出的 URL：不发现、不爬全站、不抓登录后内容。
# robots.txt 遵从（Disallow → E4013）；每域 ≤1 req/s；只收 HTML/纯文本。
# 回环 / 私网 / link-local 地址（含 DNS 解析到私网）一律 E4011，不发起请求。
# 抓取原文标 origin=user_directed_fetch，公司 origin 仍 user_imported；抓取 ≠ 采集。
# LEADPILOT_FETCH_ROBOTS=1                 # 0 仅用于本地调试，等于放弃 robots 合规
LEADPILOT_FETCH_TIMEOUT_MS=8000            # 单请求超时（1000–30000）
LEADPILOT_FETCH_MAX_BYTES=524288           # 响应体上限（≤4 MB）
LEADPILOT_FETCH_MAX_TEXT_CHARS=20000       # 正文进入 T0 的字数上限
LEADPILOT_FETCH_MAX_REDIRECTS=3            # 重定向上限（0–5），每跳重做 SSRF 校验
LEADPILOT_FETCH_MIN_INTERVAL_MS=1000       # 同域最小间隔（0–10000）
LEADPILOT_FETCH_ROBOTS_CACHE_MS=3600000    # robots.txt 缓存时长（≤24h）

# ── legacy：385 家基准集（v0.8.0 决策不做，仅将来可选）──────────────
# v0.8.0 决策：不做 385 家人工标注基准集，本通道不参与当前内测/发布判定。
# 仅在将来真的导入人工标注文件时才设置；仓库不提供也不生成任何标注样本。
# 支持 .json / .jsonl / .csv，格式见 GET /v1/eval/baseline/contract。
# 当前评测口径为 integrity + outcome：POST /v1/eval/integrity、POST /v1/eval/outcome。
# LEADPILOT_BASELINE_FILE=./data/baseline-legacy.jsonl

# ── 前端（Vite）────────────────────────────────────────────────
VITE_LEADPILOT_API=http://127.0.0.1:5181
# 仅在服务端设置了 LEADPILOT_API_TOKEN 时填写。注意：浏览器端 token 会暴露，
# 生产环境应改为同源反向代理注入，不要在公网前端直接下发长期凭据。
VITE_LEADPILOT_TOKEN=

# ── Provider API Key ───────────────────────────────────────────
# 任选其一。只配 Key 不足以发起真实调用：必须同时锁定该 provider 的
# model_version 快照（见下方 LEADPILOT_MODEL_VERSION_*），否则网关明确降级。
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 模型快照锁定（禁止 -latest 浮动指针）────────────────────────
# 值必须是 provider 官网可查的具体版本/快照 ID；基线不预置任何猜测值。
# 环境变量命名：LEADPILOT_MODEL_VERSION_<PROVIDER_KEY 大写、连字符转下划线>
# 例如：LEADPILOT_MODEL_VERSION_DEEPSEEK_PRO=deepseek-chat-2026-xxxx
# 未锁定的 provider 会在 /v1/gateway/health 里显示 pinned=false，且不进入降级链。
