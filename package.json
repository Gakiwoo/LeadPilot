{
  "name": "leadpilot",
  "private": true,
  "version": "0.9.0",
  "description": "LeadPilot 猎客 · B2B 外贸客户开发工作台（客户端基线 + 云端网关/编排器）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cloud": "node server/index.mjs",
    "smoke": "node scripts/e2e-smoke.mjs",
    "verify:restart": "bash scripts/verify-restart.sh",
    "validate:baseline": "node scripts/validate-baseline.mjs",
    "gate": "node scripts/check-release-gates.mjs",
    "evidence:check": "node scripts/check-release-evidence.mjs",
    "check:tracked": "node scripts/check-clean-checkout.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.{js,ts,json,md}\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
