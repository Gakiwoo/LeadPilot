{
  "contract": "dedupe-fingerprint-v1",
  "version": "1.0.0",
  "minNameKeyLength": 3,
  "maxSuffixStrips": 4,
  "basisOrder": ["domain", "name_country"],
  "nameNormalization": {
    "steps": [
      "nfc",
      "lowercase",
      "fullwidth_to_halfwidth",
      "punctuation_to_space",
      "strip_legal_suffix",
      "collapse_whitespace"
    ],
    "note": "纯文本归一化，不做音译、不做同义词表；两条规则都不会把不同公司名映射成同一串。"
  },
